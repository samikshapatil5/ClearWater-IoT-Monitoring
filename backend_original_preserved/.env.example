PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Optional LLM. If empty, the built-in rule/knowledge engine answers supported questions.
# This backend uses an OpenAI-compatible Chat Completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=

# Optional MQTT ingestion from ESP32 / broker.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=water/wqm-01/readings
ML_SERVICE_URL=http://localhost:8000
